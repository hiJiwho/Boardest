{
  "rules": {
    "eat_calls": {
      "$doc_id": {
        ".read": "auth != null && (auth.token.email.endsWith('.bst') || auth.token.firebase.sign_in_provider === 'google.com')",
        ".write": "auth != null && (auth.token.email.endsWith('.bst') || auth.token.firebase.sign_in_provider === 'google.com')"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
