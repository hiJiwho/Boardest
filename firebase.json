{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": [
    {
      "target": "boardest-main",
      "public": "apps/boardest/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-teacher",
      "public": "apps/boardest_teacher/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-teacher-lite",
      "public": "apps/boardest_teacher_lite/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "update-work",
      "public": "infra/update_work_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "what-is-boardest",
      "public": "infra/landing_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-control",
      "public": "apps/boardest_control/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-teacher-oauth",
      "public": "apps/boardest_teacher_oauth",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "welcome-to-boardest",
      "public": "infra/welcome_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.ps1",
          "headers": [
            { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.appinstaller",
          "headers": [
            { "key": "Content-Type", "value": "application/appinstaller; charset=utf-8" },
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/boardest.appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.appx",
          "type": 302
        },
        {
          "source": "/teacher.appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/bst-teacher.appx",
          "type": 302
        },
        {
          "source": "/bst-teacher.appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/bst-teacher.appx",
          "type": 302
        },
        {
          "source": "/boardest.apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.apk",
          "type": 302
        },
        {
          "source": "/login",
          "destination": "https://boardest-teacher-oauth.web.app",
          "type": 302
        },
        {
          "source": "/oauth",
          "destination": "https://boardest-teacher-oauth.web.app",
          "type": 302
        },
        {
          "source": "/eat",
          "destination": "https://boardest-teacher-lite.web.app",
          "type": 302
        }
      ],
      "cleanUrls": true
    },
    {
      "target": "download-boardest",
      "public": "infra/download_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.ps1",
          "headers": [
            { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.appinstaller",
          "headers": [
            { "key": "Content-Type", "value": "application/appinstaller; charset=utf-8" },
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.cer",
          "headers": [
            { "key": "Content-Type", "value": "application/x-x509-ca-cert" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/bst.apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.apk",
          "type": 302
        },
        {
          "source": "/boardest.apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.apk",
          "type": 302
        },
        {
          "source": "/apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.apk",
          "type": 302
        },
        {
          "source": "/bst.appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.appx",
          "type": 302
        },
        {
          "source": "/boardest.appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.appx",
          "type": 302
        },
        {
          "source": "/appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.appx",
          "type": 302
        },
        {
          "source": "/teacher.appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/bst-teacher.appx",
          "type": 302
        },
        {
          "source": "/bst-teacher.appx",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/bst-teacher.appx",
          "type": 302
        },
        {
          "source": "/cer",
          "destination": "/BoardestCert.cer",
          "type": 302
        },
        {
          "source": "/cert",
          "destination": "/BoardestCert.cer",
          "type": 302
        },
        {
          "source": "/win-cer",
          "destination": "/win-cer.ps1",
          "type": 302
        }
      ],
      "cleanUrls": true
    }
  ]
}
