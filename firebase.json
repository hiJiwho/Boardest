{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": [
    {
      "target": "boardest-main",
      "public": "infra/hub_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "/web", "destination": "/web/index.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-downloads",
      "public": "infra/downloads_hub_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "/Class-Win-Guide", "destination": "/Class-Win-Guide/index.html" },
        { "source": "/Teacher-PRO-Guide", "destination": "/Teacher-PRO-Guide/index.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-class",
      "public": "apps/boardest/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        },
        {
          "source": "**/*.@(wasm|js|otf|ttf|woff|woff2|png|jpg|jpeg|gif|svg|ico)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-demo",
      "public": "infra/demo_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "cleanUrls": true,
      "rewrites": [
        { "source": "/class", "destination": "/class/index.html" },
        { "source": "/class/**", "destination": "/class/index.html" },
        { "source": "/teacher", "destination": "/teacher/index.html" },
        { "source": "/teacher/**", "destination": "/teacher/index.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-teacher",
      "public": "apps/boardest_teacher/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        },
        {
          "source": "**/*.@(wasm|js|otf|ttf|woff|woff2|png|jpg|jpeg|gif|svg|ico)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "what-is-boardest",
      "public": "infra/landing_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://boardest-downloads.web.app",
          "type": 302
        },
        {
          "source": "/:path*",
          "destination": "https://bst-installer.web.app/:path*",
          "type": 302
        }
      ]
    },
    {
      "target": "boardest-control",
      "public": "apps/boardest_control/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-teacher-oauth",
      "public": "apps/boardest_teacher_oauth",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "boardest-eat",
      "public": "infra/boardest_eat_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "bst-installer",
      "public": "infra/download_web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.ps1",
          "headers": [
            { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.appinstaller",
          "headers": [
            { "key": "Content-Type", "value": "application/appinstaller" },
            { "key": "Cache-Control", "value": "no-cache, max-age=0" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.cer",
          "headers": [
            { "key": "Content-Type", "value": "application/x-x509-ca-cert" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "**/*.appx",
          "headers": [
            { "key": "Content-Type", "value": "application/appx" },
            { "key": "Cache-Control", "value": "no-cache, max-age=0" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/bst.apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.apk",
          "type": 302
        },
        {
          "source": "/boardest.apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.apk",
          "type": 302
        },
        {
          "source": "/apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/boardest.apk",
          "type": 302
        },
        {
          "source": "/bst-teacher.apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/bst-teacher.apk",
          "type": 302
        },
        {
          "source": "/teacher.apk",
          "destination": "https://github.com/hiJiwho/Boardest/releases/latest/download/bst-teacher.apk",
          "type": 302
        },
        {
          "source": "/cer",
          "destination": "/BoardestCert.cer",
          "type": 302
        },
        {
          "source": "/cert",
          "destination": "/BoardestCert.cer",
          "type": 302
        },
        {
          "source": "/win-cer",
          "destination": "/win-cer.ps1",
          "type": 302
        }
      ],
      "cleanUrls": true
    }
  ]
}
