{
  "rules": {
    "eat_calls": {
      ".read": true,
      "$doc_id": {
        ".write": "!newData.exists() || newData.hasChildren(['schoolCode', 'grade', 'classNum'])",
        ".indexOn": ["schoolCode", "cafeteriaNum", "isOnline", "lastActive"]
      }
    },
    "demo_active_devices": {
      ".read": true,
      "$device_id": {
        ".write": true
      }
    },
    "meal_votes": {
      ".read": true,
      "$vote_key": {
        ".write": true
      }
    },
    "passkey": {
      ".read": false,
      ".write": false,
      "sessions": {
        ".read": false,
        "$session_id": {
          ".read": true,
          ".write": true
        }
      },
      "vaults": {
        ".read": false,
        "$teacher_key": {
          ".read": true,
          ".write": true
        }
      },
      "auto_otp": {
        ".read": false,
        "$token": {
          ".read": true,
          ".write": true
        }
      }
    },
    "passkey_pairs": {
      "$pair_id": {
        ".read": true,
        ".write": true
      }
    },
    "passkey_vaults": {
      "$vault_id": {
        ".read": true,
        ".write": true
      }
    }
  }
}
