{
  "rules": {
    "eat_calls": {
      ".read": true,
      "$doc_id": {
        ".write": "!newData.exists() || newData.hasChildren(['schoolCode', 'grade', 'classNum'])",
        ".indexOn": ["schoolCode", "cafeteriaNum", "isOnline", "lastActive"]
      }
    },
    "demo_active_devices": {
      ".read": true,
      "$device_id": {
        ".write": true
      }
    },
    "meal_votes": {
      ".read": true,
      "$vote_key": {
        ".write": true
      }
    },
    "cloud_pair_sessions": {
      "$session_id": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists() || (data.child('status').val() == 'pending' && (newData.child('status').val() == 'authenticated' || newData.child('status').val() == 'consumed')) || data.child('status').val() == 'authenticated'",
        ".validate": "newData.hasChildren(['status']) && newData.child('status').isString()"
      }
    },
    "passkey": {
      ".read": false,
      ".write": false,
      "sessions": {
        ".read": false,
        "$session_id": {
          ".read": true,
          ".write": "!data.exists() || !newData.exists() || (data.child('status').val() == 'waiting' && (newData.child('status').val() == 'approved' || newData.child('status').val() == 'rejected'))",
          ".validate": "newData.hasChildren(['status']) && newData.child('status').isString()"
        }
      },
      "vaults": {
        ".read": false,
        "$teacher_key": {
          ".read": true,
          ".write": true
        }
      },
      "auto_otp": {
        ".read": false,
        "$token": {
          ".read": true,
          ".write": true
        }
      }
    },
    "passkey_pairs": {
      "$pair_id": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists() || (data.child('status').val() == 'waiting' && newData.child('status').val() == 'approved') || newData.child('status').val() == 'registered'"
      }
    },
    "assessments": {
      ".read": true,
      ".write": true
    },
    "school_notices": {
      ".read": true,
      ".write": true
    }
  }
}
