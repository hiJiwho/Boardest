{
  "manifest_version": 3,
  "name": "Boardest BoardBook",
  "version": "5.1.2",
  "description": "Boardest TBP 전자교과서 및 HTMLP 스마트교안 전용 Flutter 기반 BoardBook 캡처 & 우측 판서 엔진",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Boardest BoardBook (Flutter)",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "externally_connectable": {
    "matches": [
      "https://boardest-class.web.app/*",
      "https://boardest-teacher.web.app/*",
      "https://boardest-demo.web.app/*",
      "http://localhost:*/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "boardbook_flutter.html",
        "boardbook.html",
        "boardbook.js",
        "boardbook.css",
        "flutter/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
